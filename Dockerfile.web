# Stage 1: Build React Web UI
FROM node:25-alpine AS ui-builder

WORKDIR /app/web

# Install dependencies
COPY web/package.json web/package-lock.json* ./
RUN npm ci || npm install

# Copy web source code and build production assets
COPY web/ ./
ARG IMAGE_TAG=dev
RUN VITE_BUILD_VERSION=${IMAGE_TAG} npm run build

# Stage 2: Serve Web UI via Nginx unprivileged container
FROM nginx:alpine

RUN apk upgrade --no-cache ca-certificates ca-certificates-bundle

# Copy custom Nginx configuration
COPY web/nginx.conf /etc/nginx/conf.d/default.conf

# Copy compiled static assets from ui-builder stage
COPY --from=ui-builder /app/web/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
