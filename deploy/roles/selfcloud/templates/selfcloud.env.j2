# SelfCloud Environment File (Managed by Ansible)
SERVER_PORT=8080
DB_DRIVER=mysql
DB_DSN={{ db_user }}:{{ db_password }}@tcp({{ db_host }}:{{ db_port | default(3306) }})/{{ db_name }}?parseTime=true
STORAGE_DIR=/var/lib/selfcloud/data
SERVE_STATIC=false
AUTO_MIGRATE={{ auto_migrate | default('true') }}
LOG_LEVEL={{ log_level | default('info') }}

# Upload & Security Settings
MAX_UPLOAD_SIZE_BYTES={{ max_upload_size_bytes | default('10737418240') }}
TRUST_PROXY={{ trust_proxy | default('true') }}
COOKIE_SECURE={{ cookie_secure | default('true' if (enable_ssl | default(false) | bool) else 'auto') }}
SERVER_READ_TIMEOUT={{ server_read_timeout | default('30m') }}
RATE_LIMIT_LOGIN_REQUESTS={{ rate_limit_login_requests | default(15) }}
RATE_LIMIT_LOGIN_WINDOW={{ rate_limit_login_window | default('1m') }}
{% if metrics_auth_token is defined and metrics_auth_token %}
METRICS_AUTH_TOKEN={{ metrics_auth_token }}
{% endif %}
{% if auth_methods is defined and auth_methods %}
AUTH_METHODS={{ auth_methods if auth_methods is string else (auth_methods | join(',')) }}
{% else %}
AUTH_METHODS=basic,oauth
{% endif %}

{% if sso_google_client_id is defined and sso_google_client_id %}
SSO_GOOGLE_CLIENT_ID={{ sso_google_client_id }}
SSO_GOOGLE_CLIENT_SECRET={{ sso_google_client_secret }}
SSO_REDIRECT_BASE_URL={{ sso_redirect_base_url | default(('https://' if (enable_ssl | default(false) | bool) else 'http://') ~ domain_name) }}
{% endif %}
