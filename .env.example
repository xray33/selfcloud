# SelfCloud Docker Compose Environment File (.env)
# Copy to .env in repository root to customize local/persistent installations

# Web UI Port (default: 8080)
WEB_PORT=8080

# Database Port (default: 3306)
DB_PORT=3306

# Host storage & database directories
DATA_DIR=./data
DB_DATA_DIR=mariadb_data

# Database Credentials
DB_NAME=selfcloud
DB_USER=selfcloud
DB_PASSWORD=selfcloud_pass
DB_ROOT_PASSWORD=root_password

# Application Settings
AUTO_MIGRATE=true
LOG_LEVEL=info

# Upload and Security Settings
# MAX_UPLOAD_SIZE_BYTES=10737418240  # 10GB
# TRUST_PROXY=true                  # Trust X-Forwarded-Proto / X-Forwarded-For
# COOKIE_SECURE=auto                # auto, true, or false
# SERVER_READ_TIMEOUT=30m           # Slowloris protection timeout
# RATE_LIMIT_LOGIN_REQUESTS=15      # Max requests per window per IP (0 to disable)
# RATE_LIMIT_LOGIN_WINDOW=1m        # Rate limit sliding window

# Optional Google OAuth2 SSO
SSO_GOOGLE_CLIENT_ID=
SSO_GOOGLE_CLIENT_SECRET=
SSO_REDIRECT_BASE_URL=http://localhost:8080

